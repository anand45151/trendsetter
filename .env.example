# TrendRadar — Firebase Configuration
# Rename this file to .env.local and fill in your Firebase project credentials.
# Get these from: https://console.firebase.google.com → Your Project → Project Settings → Web Apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─────────────────────────────────────────
# Without these keys the app runs in DEMO MODE:
#   • Google Sign-In is simulated (no real OAuth popup)
#   • Trend data is served from local mock telemetry
#   • Firestore writes are skipped
# ─────────────────────────────────────────

# GitHub API — for live repo telemetry (optional, raises rate limit)
VITE_GITHUB_TOKEN=ghp_your_github_personal_access_token
